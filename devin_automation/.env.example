#
# Copy to devin_automation/.env (git-ignored) and fill in.
#
# Required
DEVIN_AUTOMATION_GITHUB_TOKEN=
DEVIN_AUTOMATION_DEVIN_API_KEY=
DEVIN_AUTOMATION_REPO=kznovo/superset

# Optional
DEVIN_AUTOMATION_BASE_BRANCH=master
DEVIN_AUTOMATION_ENABLED=true
# Start here: observe every decision without writing to GitHub or Devin.
DEVIN_AUTOMATION_DRY_RUN=true
DEVIN_AUTOMATION_POLL_INTERVAL_SECONDS=60
DEVIN_AUTOMATION_AUTO_MERGE=true
DEVIN_AUTOMATION_REQUIRE_GREEN_CI=true
DEVIN_AUTOMATION_MERGE_METHOD=squash
DEVIN_AUTOMATION_MAX_CLARIFICATION_ROUNDS=3
DEVIN_AUTOMATION_MAX_REVIEW_ROUNDS=3
DEVIN_AUTOMATION_MAX_CONCURRENT_SESSIONS=3
# Only act on issues carrying this label, e.g. `devin`. Empty means all issues.
DEVIN_AUTOMATION_ISSUE_LABEL_FILTER=
DEVIN_AUTOMATION_PORT=8200
